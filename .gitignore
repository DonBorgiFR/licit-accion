# Entorno y Secretos
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Python
# Los artefactos de empaquetado se anclan con "/" a la raíz del proyecto.
# Sin la barra inicial, un patrón como "lib/" casa con CUALQUIER carpeta llamada
# lib a cualquier profundidad y excluía frontend/src/lib/ (api-client, react-query,
# utils): un clon limpio no compilaba el Cockpit.
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
/env/
/venv/
/ENV/
/.venv/
/build/
/develop-eggs/
/dist/
/downloads/
/eggs/
/.eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/
*.egg-info/
.installed.cfg
*.egg

# Pytest y Cobertura
.pytest_cache/
.coverage
htmlcov/

# Base de Datos y Almacenamiento Local
*.db
*.db-wal
*.db-shm
*.db.lock
data/licitaciones.db*
data/documents/
data/backups/
data/pipeline.jsonl
# Y sus dos acompanantes, que la linea de arriba NO cubre porque es una ruta exacta y no un
# prefijo. Detectado el 2026-09-01 al cerrar H-55, con el fichero de cerrojo recien creado
# asomando en `git status`: es la misma familia que el descuido de `alertas_tempranas.csv` de
# aqui abajo, y la rotacion a los 10 MB habria traido el segundo caso sin avisar.
data/pipeline.jsonl.lock
data/pipeline_*.jsonl
data/reports/*.csv
# Informe del Centinela. Vive en la raíz de data/ y no en data/reports/, así que se escapaba de
# la línea de arriba y quedó versionado por descuido en el cierre de la Capa 9. Es un artefacto
# que el pipeline reescribe en cada corrida: dejarlo dentro mete ruido en todos los commits.
data/alertas_tempranas.csv
# Volcado de cada prospeccion lanzada por el lanzador (Capa 10, Paso 6): es salida de
# ejecucion, no codigo, y es donde queda el rastro cuando el pipeline corre sin consola.
data/logs/

# Capa 10, Paso 7: el perfil aislado del navegador con el que se abre el Cockpit en modo
# aplicacion. Son miles de ficheros que Chrome/Edge gestionan solos y que no pertenecen al
# proyecto; se recrea solo en el primer arranque de cada equipo.
data/perfil_cockpit/
# Marca del servidor propio (PID + instante de creacion). Es estado de una ejecucion viva.
data/lanzador.pid

# Hojas de cálculo: se excluyen las salidas de ejecución, pero el perfil de CPVs
# de Incoop es configuración de entrada y viaja con el código.
*.xlsx
!CPVs_Incoop.xlsx

# Frontend / Node
frontend/node_modules/
frontend/dist/
frontend/.cache/
.eslintcache

# IDEs y Editores
.vscode/
.idea/
*.swp
*.swo
.DS_Store
